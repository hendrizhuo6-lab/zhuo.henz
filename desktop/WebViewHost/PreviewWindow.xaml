<Window x:Class="DomainOpsConsole.WebViewHost.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Domain Ops WebView"
        Width="1180"
        Height="800"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#0A0F0B"
        Loaded="Window_Loaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="10" LastChildFill="True">
      <Button x:Name="BackButton" DockPanel.Dock="Left" Width="38" Margin="0,0,6,0"
              Content="←" ToolTip="Kembali" Click="BackButton_Click" />
      <Button x:Name="ForwardButton" DockPanel.Dock="Left" Width="38" Margin="0,0,8,0"
              Content="→" ToolTip="Maju" Click="ForwardButton_Click" />
      <Button DockPanel.Dock="Right" Width="72" Margin="8,0,0,0"
              Content="Buka" Click="GoButton_Click" />
      <TextBox x:Name="AddressBar" MinHeight="34" Padding="10,6"
               VerticalContentAlignment="Center" KeyDown="AddressBar_KeyDown" />
    </DockPanel>
    <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="10,6"
               Foreground="#86EFAC" Text="Menyiapkan WebView2..." />
  </Grid>
</Window>
